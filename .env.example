# Base de données Neon (PostgreSQL)
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# Neon Object Storage (S3-compatible)
AWS_ENDPOINT_URL_S3="https://br-xxx.storage.c-2.us-east-2.aws.neon.tech"
AWS_ACCESS_KEY_ID="nak_live_xxxxxxxx"
AWS_SECRET_ACCESS_KEY="nsk_live_xxxxxxxxxxxxxxxx"
AWS_REGION="us-east-2"
BUCKET_NAME="electro-products"

# Application
APP_URL=https://www.electro-domesticos.com

# SMTP (Hostinger) — emails de confirmation de commande
# IMPORTANT : mettez les valeurs avec #, * ou $ entre guillemets
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contacto@electro-domesticos.com
SMTP_PASS="xxxxxxxx"
SMTP_FROM=BSH Electrodomésticos España, S.A.

# Email destinataire admin (notifications de nouvelles commandes)
# Si non défini, l'admin recevra les notifications sur SMTP_USER
ADMIN_EMAIL=admin@electro-domesticos.com

# Admin (mot de passe unique)
ADMIN_PASSWORD="changeme"
JWT_SECRET=un-texte-aleatoire-long-au-moins-32-caracteres

# Google Search Console (SEO / dashboard tráfico)
# 1) Créer une compte de service dans Google Cloud Console
#    (client_email + private_key de la clé JSON, la clé peut être en base64)
# 2) Habiliter "Google Search Console API"
# 3) Ajouter l'email du service account comme utilisateur de la propriété
#    Search Console (rôle full)
# 4) GSC_SITE_URL : sc-domain:electro-domesticos.com ou https://www.electro-domesticos.com/
GSC_CLIENT_EMAIL=compte-service@projet.iam.gserviceaccount.com
GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GSC_SITE_URL=sc-domain:electro-domesticos.com